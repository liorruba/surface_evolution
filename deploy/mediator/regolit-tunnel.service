# systemd *user* unit: reverse SSH tunnel that exposes the local REGOLIT server on the droplet's
# localhost port, where nginx proxies regolit.liorruba.com to it. Reconnects on any failure.
[Unit]
Description=Reverse SSH tunnel publishing REGOLIT on the droplet (127.0.0.1:__PORT__)
After=network-online.target regolit-web.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new -R 127.0.0.1:__PORT__:127.0.0.1:__PORT__ __DROPLET__
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
